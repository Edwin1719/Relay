# Copia este archivo a backend/.env y rellena solo lo que uses.
# Sin claves puedes trabajar con los modelos gratuitos de APInex si tienes cuenta.

# DeepSeek (tier "deep")
DEEPSEEK_API_KEY=

# APInex (modelos free/*)
APINEX_API_KEY=

# Opcional: fijar la lista de modelos gratuitos de APInex
# KODAMA_APINEX_MODELS="free/a,free/b@65536"

# Opcional: ruta del filtro de la skill rtk (ver README)
# KODAMA_RTK_FILTER=

# Opcional: binario de codebase-memory-mcp si no está en PATH
# CODEBASE_MEMORY_BIN=
